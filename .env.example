# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env ke repo.
# Lihat src/config.ts untuk validasi & nilai default.

# --- Wajib ---
TAVILY_API_KEY=
GEMINI_API_KEYS=key-1,key-2,key-3
MCP_API_KEY=ganti-dengan-api-key-kuat

# --- Opsional ---
EXA_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
MAX_CHARS_PER_DOC=15000
DEFAULT_MAX_CANDIDATES=5

# Rate limit berlaku PER KEY, bukan total
RATE_LIMIT_RPM=15
RATE_LIMIT_TPM=250000

GEMINI_KEY_MAX_WAIT_MS=70000

# Port hanya dipakai saat jalan lokal tanpa Docker (npm start).
# Di Docker, PORT=3000 di-set otomatis via Dockerfile/docker-compose.yml.
MCP_PORT=5000

MCP_ICON_URL=

# Tuning lanjutan (punya default di src/config.ts, kosongkan = pakai default)
# MAX_CONCURRENT_DOWNLOADS=3
# MAX_TOTAL_DOWNLOAD_BYTES=104857600
# MAX_DOWNLOAD_BYTES_PER_FILE=20971520
# DOWNLOAD_SEMAPHORE_TIMEOUT_MS=30000
# GEMINI_CALL_TIMEOUT_MS=15000
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# CIRCUIT_BREAKER_COOLDOWN_MS=60000

# Port host untuk docker-compose (Host:Container = HOST_PORT:3000)
HOST_PORT=5000
